{
  "name": {
    "en": "Fully Kiosk Browser"
  },
  "class": "other",
  "capabilities": [
    "onoff"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "discovery": "fully",
  "pair": [
    {
      "id": "start",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "enter_password"
      },
      "options": {
        "singular": true
      }
    },
    {
      "id": "enter_password"
    },
    {
      "id": "enter_ip"
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Password"
      }
    },
    {
      "id": "ip_address",
      "type": "text",
      "label": {
        "en": "IP Address"
      },
      "value": "",
      "hint": {
        "en": "Manually enter the IP address of your device. Leave empty to use automatic discovery using mDNS-SD."
      }
    }
  ]
}